{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thelinyue/Hephaestus-Workbench-Plugins/blob/main/schema/catalog.schema.json",
  "title": "Hephaestus Workbench Extension Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extensions"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "publisherId", "kind", "releases"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "publisherId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["workspace", "analysis", "maintenance"]
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "minHostVersion", "url", "size", "sha256", "signature"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "minHostVersion": {
          "$ref": "#/$defs/semver"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "signature"],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "\\S"
        },
        "signature": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$"
        }
      }
    }
  }
}
