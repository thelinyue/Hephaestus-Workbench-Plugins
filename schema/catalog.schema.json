{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thelinyue/Hephaestus-Workbench-Plugins/blob/main/schema/catalog.schema.json",
  "title": "Hephaestus Workbench Plugin Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "author",
        "license",
        "minWorkbenchVersion",
        "repository",
        "downloadUrl",
        "sha256",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "minWorkbenchVersion": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/.+/releases/download/.+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "type", "entry"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "Exe"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string"
        },
        "reportPath": {
          "type": "string"
        }
      }
    }
  }
}
